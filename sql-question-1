WITH date1 AS (
    SELECT
        customer_id,
        order_amount,
        MIN(order_date) AS first_visite_date
    FROM
        customer_orders
    GROUP BY
        customer_id,
        order_amount
)
SELECT
    c.order_date,
    SUM(
        CASE
            WHEN c.order_date = o.first_visite_date THEN
                1
            ELSE
                0
        END
    ) AS first_visit_flag,
    SUM(
        CASE
            WHEN c.order_date <> o.first_visite_date THEN
                1
            ELSE
                0
        END
    ) AS repeat_visit_flag,
    SUM(
        CASE
            WHEN c.order_date = o.first_visite_date THEN
                o.order_amount
            ELSE
                0
        END
    ) AS first_visit_amount,
    SUM(
        CASE
            WHEN c.order_date <> o.first_visite_date THEN
                o.order_amount
            ELSE
                0
        END
    ) AS repeat_visit_amount
FROM
    customer_orders c,
    date1                   o
WHERE
    c.customer_id = o.customer_id
GROUP BY
    c.order_date
ORDER BY
    c.order_date;